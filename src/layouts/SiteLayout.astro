---
import { site } from '../config/site';
import { locales, localePath, privacyPath, type LocaleId } from '../content/locales';
import { getCopy } from '../content/copy';
import '../styles/global.css';
interface Props {
  locale: LocaleId;
  page?: 'home' | 'privacy';
  title?: string;
  description?: string;
}
const {
  locale,
  page = 'home',
  title = `Vetra - ${getCopy(Astro.props.locale).hero.title}`,
  description,
} = Astro.props;
const copy = getCopy(locale);
const language = locales.find((item) => item.id === locale)!;
const pagePath = page === 'privacy' ? privacyPath : localePath;
const canonical = new URL(pagePath(locale), site.origin).href;
---

<!doctype html>
<html lang={language.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? copy.meta.description} />
    <meta name="theme-color" content="#f8faf8" />
    <link rel="icon" type="image/png" href={`${site.base}assets/icon-192.png`} />
    <link rel="canonical" href={canonical} />
    {locales.map((item) => (
      <link
        rel="alternate"
        hreflang={item.lang}
        href={new URL(pagePath(item.id), site.origin).href}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath('en'), site.origin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.origin}${site.base}assets/icon-512.png`} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('vetra.site.theme') ?? localStorage.getItem('vetra_theme');
        const theme = (saved === 'light' || saved === 'dark')
          ? saved
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <div class="page-spotlight" aria-hidden="true">
      <div class="page-spotlight-orb" aria-hidden="true"></div>
    </div>
    <div class="bg-texture" aria-hidden="true"></div>
    <div class="custom-cursor-dot" aria-hidden="true"></div>
    <div class="custom-cursor-ring" aria-hidden="true"></div>
    <div class="autoscroll-origin" aria-hidden="true"></div>
    <div class="autoscroll-anchor" aria-hidden="true">
      <svg class="autoscroll-arrow autoscroll-arrow-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
      <div class="autoscroll-center-dot"></div>
      <svg class="autoscroll-arrow autoscroll-arrow-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
    <slot />
    <script>
      import { initPreferences } from '../scripts/preferences';
      initPreferences();
    </script>
  </body>
</html>
