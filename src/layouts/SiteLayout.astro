---
import { site } from '../config/site';
import { locales, localePath, type LocaleId } from '../content/locales';
import { getCopy } from '../content/copy';
interface Props { locale: LocaleId }
const { locale } = Astro.props;
const copy = getCopy(locale);
const language = locales.find(item => item.id === locale)!;
const canonical = new URL(localePath(locale), site.origin).href;
---
<!doctype html>
<html lang={language.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vetra — {copy.hero.title}</title>
    <meta name="description" content={copy.meta.description} />
    <meta name="theme-color" content="#f6f7f2" />
    <link rel="icon" type="image/png" href={`${site.base}assets/icon-192.png`} />
    <link rel="canonical" href={canonical} />
    {locales.map(item => <link rel="alternate" hreflang={item.lang} href={new URL(localePath(item.id), site.origin).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(site.base, site.origin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Vetra — ${copy.hero.title}`} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.origin}${site.base}assets/icon-512.png`} />
  </head>
  <body>
    <slot />
  </body>
</html>
