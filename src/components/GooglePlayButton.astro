---
import { site } from '../config/site';
import type { LocaleId } from '../content/types';

interface Props {
  locale: LocaleId;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;

const labels: Record<LocaleId, { sub: string; main: string }> = {
  pt: { sub: 'DISPONÍVEL NO', main: 'Google Play' },
  'pt-br': { sub: 'DISPONÍVEL NO', main: 'Google Play' },
  en: { sub: 'GET IT ON', main: 'Google Play' },
  'en-gb': { sub: 'GET IT ON', main: 'Google Play' },
  es: { sub: 'DISPONIBLE EN', main: 'Google Play' },
  fr: { sub: 'DISPONIBLE SUR', main: 'Google Play' },
  de: { sub: 'JETZT BEI', main: 'Google Play' },
  it: { sub: 'DISPONIBILE SU', main: 'Google Play' },
  zh: { sub: '前往下载', main: 'Google Play' },
};

const label = labels[locale] ?? labels.en;
---

<a
  href={site.playUrl}
  class={`google-play-btn ${className}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label.sub} ${label.main}`}
>
  <span class="play-icon-wrap" aria-hidden="true">
    <svg class="play-logo" viewBox="0 0 28.99 31.99" width="27" height="30" aria-hidden="true">
      <path d="M13.54 15.28.12 29.34a3.66 3.66 0 0 0 5.33 2.16l15.1-8.6Z" fill="#EA4335"/>
      <path d="m27.11 12.89-6.53-3.74-7.35 6.45 7.38 7.28 6.48-3.7a3.54 3.54 0 0 0 1.5-4.79 3.62 3.62 0 0 0-1.5-1.5z" fill="#FBBC04"/>
      <path d="M.12 2.66a3.57 3.57 0 0 0-.12.92v24.84a3.57 3.57 0 0 0 .12.92L14 15.64Z" fill="#4285F4"/>
      <path d="m13.64 16 6.94-6.85L5.5.51A3.73 3.73 0 0 0 3.63 0 3.64 3.64 0 0 0 .12 2.65Z" fill="#34A853"/>
    </svg>
  </span>
  <span class="play-copy">
    <span class="play-sub">{label.sub}</span>
    <span class="play-main">{label.main}</span>
  </span>
</a>
