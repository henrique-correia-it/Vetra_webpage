---
import { site } from '../config/site';
import { locales, localePath, privacyPath, flagFiles } from '../content/locales';
import type { LocaleId, SiteCopy } from '../content/types';
import Icon from './Icon.astro';
interface Props {
  locale: LocaleId;
  copy: SiteCopy;
  page?: 'home' | 'privacy';
}
const { locale, copy, page = 'home' } = Astro.props;
const languagePath = page === 'privacy' ? privacyPath : localePath;
const home = page === 'privacy' ? localePath(locale) : '';
---

<a class="skip-link" href="#main">
  {copy.nav.skip}
</a>
<header class="site-header">
  <div class="header-inner wrap">
    <a class="brand" href={localePath(locale)} aria-label="Vetra">
      <div class="brand-icon-wrapper">
        <img src={`${site.base}assets/icon-192.png`} width="34" height="34" alt="" />
      </div>
      <span class="brand-name">Vetra</span>
    </a>

    <nav class="primary-nav" aria-label={copy.nav.features}>
      <a href={`${home}#features`} class="nav-link">{copy.nav.features}</a>
      <a href={`${home}#faq`} class="nav-link">{copy.nav.faq}</a>
    </nav>

    <div class="header-actions">
      <details class="language-menu">
        <summary aria-label={copy.nav.language}>
          <img
            class="language-flag"
            src={`${site.base}assets/flags/${flagFiles[locale]}.png`}
            width="18"
            height="18"
            alt=""
          />
          <span class="language-code">{locale === 'pt-br' ? 'BR' : locale.toUpperCase()}</span>
          <Icon name="down" size={11} />
        </summary>
        <div class="language-options">
          {locales.map((item) => (
            <a
              href={languagePath(item.id)}
              data-language={item.id}
              lang={item.lang}
              hreflang={item.lang}
              aria-current={item.id === locale ? 'page' : undefined}
            >
              <img
                class="language-flag"
                src={`${site.base}assets/flags/${flagFiles[item.id]}.png`}
                width="20"
                height="20"
                alt=""
              />
              <span>{item.label}</span>
              {item.id === locale && <Icon name="check" size={15} />}
            </a>
          ))}
        </div>
      </details>

      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label={copy.nav.theme}
        title={copy.nav.theme}
      >
        <span data-theme-icon="light">
          <Icon name="sun" size={17} />
        </span>
        <span data-theme-icon="dark" hidden>
          <Icon name="moon" size={17} />
        </span>
      </button>

      <a
        class="header-cta"
        href={site.playUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${copy.nav.download} - Google Play`}
      >
        <span class="header-cta-icon-wrap" aria-hidden="true">
          <svg class="header-cta-play" viewBox="0 0 28.99 31.99" width="14" height="16" aria-hidden="true">
            <path d="M13.54 15.28.12 29.34a3.66 3.66 0 0 0 5.33 2.16l15.1-8.6Z" fill="#EA4335"/>
            <path d="m27.11 12.89-6.53-3.74-7.35 6.45 7.38 7.28 6.48-3.7a3.54 3.54 0 0 0 1.5-4.79 3.62 3.62 0 0 0-1.5-1.5z" fill="#FBBC04"/>
            <path d="M.12 2.66a3.57 3.57 0 0 0-.12.92v24.84a3.57 3.57 0 0 0 .12.92L14 15.64Z" fill="#4285F4"/>
            <path d="m13.64 16 6.94-6.85L5.5.51A3.73 3.73 0 0 0 3.63 0 3.64 3.64 0 0 0 .12 2.65Z" fill="#34A853"/>
          </svg>
        </span>
        <span class="header-cta-label">{copy.nav.download}</span>
        <Icon name="arrow" size={12} />
      </a>
    </div>
  </div>
</header>
