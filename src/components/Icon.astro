  check: 'm5 12 4 4L19 6',
  moon: 'M20.6 13.3A9 9 0 0 1 10.7 3.4 9 9 0 1 0 20.6 13.3Z',
  plan: 'M5 4h14v16H5zM9 8h6M9 12h6M9 16h3',
  wallet: 'M4 5h14v4H4a2 2 0 0 1 0-4ZM4 9h16v11H4a2 2 0 0 1-2-2V7m13 7h5',
