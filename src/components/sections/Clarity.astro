---
import type { LocaleId, SiteCopy } from '../../content/types';
import AppImage from '../AppImage.astro';
interface Props {
  locale: LocaleId;
  copy: SiteCopy;
}
const { locale, copy } = Astro.props;
---

<section class="chapter clarity-chapter">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">{copy.clarity.eyebrow}</p>
      <h2>{copy.clarity.title}</h2>
      <p class="lede">{copy.clarity.text}</p>
    </div>
    <div class="clarity-showcase">
      <div class="clarity-phone-column">
        <div class="phone-frame">
          <AppImage locale={locale} scene="transactions" alt={copy.clarity.items[1]} />
        </div>
        <p class="clarity-caption">{copy.clarity.items[1]}</p>
      </div>
      <div class="clarity-phone-column clarity-offset">
        <div class="phone-frame">
          <AppImage locale={locale} scene="insights" alt={copy.clarity.items[2]} />
        </div>
        <p class="clarity-caption">{copy.clarity.items[2]}</p>
      </div>
    </div>
  </div>
</section>
