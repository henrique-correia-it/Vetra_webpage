---

<section class="chapter showcase-chapter" aria-labelledby="showcase-title">
  <div class="wrap">
    <div class="showcase-header">
      <div class="showcase-header-text">
        <p class="eyebrow">{header.eyebrow}</p>
        <h2 id="showcase-title">{header.title}</h2>
      </div>
    </div>

    <!-- 3D Coverflow Game Gallery Track with Infinite Loop & Grab-to-Scroll -->
    <div class="showcase-track-container">
      <!-- Floating Navigation Arrows -->
      <button
        type="button"
        class="showcase-nav-btn prev"
        data-showcase-prev
        aria-label={locale === 'pt' || locale === 'pt-br' ? 'Ecrã anterior' : 'Previous screen'}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        type="button"
        class="showcase-nav-btn next"
        data-showcase-next
        aria-label={locale === 'pt' || locale === 'pt-br' ? 'Próximo ecrã' : 'Next screen'}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div
        class="showcase-track"
        data-showcase-track
        tabindex="0"
        role="region"
        aria-label={header.title}
      >
        {[0, 1, 2].flatMap((loopIdx) =>
          items.map((item, i) => {
            const cardIdx = loopIdx * items.length + i;
            return (
              <article
                class="showcase-card"
                data-showcase-card={cardIdx}
                data-loop-index={loopIdx}
                data-screen-index={i}
              >
                <div class="showcase-phone-frame phone-frame">
                  <AppImage
                    locale={locale}
                    scene={item.scene}
                    alt={item.title}
                    eager={true}
                  />
                </div>
                <div class="showcase-card-caption">
                  <div class="showcase-card-badge">
                    <span class="showcase-card-num">0{i + 1}</span>
                    <span class="showcase-card-title">{item.title}</span>
                  </div>
                  <p class="showcase-card-desc">{item.subtitle}</p>
                </div>
              </article>
            );
          })
        )}
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-showcase-track]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-showcase-card]'));
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-showcase-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-showcase-next]');

  if (track && cards.length > 0) {
    const itemCount = 8;
    let targetIndex = itemCount; // Start at 8 (screen 1, middle set)
    let isDown = false;
    let startX = 0;
    let scrollStart = 0;
    let isDragging = false;
    let dragDistance = 0;
    let ticking = false;
    let animId: number | null = null;

    // Helper: calculate exact width of one 8-card cycle
    const getLoopWidth = () => {
      if (cards.length < 16) return 0;
      return cards[itemCount].offsetLeft - cards[0].offsetLeft;
    };

    // Helper: get scrollLeft needed to center a card index
    const getScrollForCard = (index: number) => {
      const safeIdx = Math.max(0, Math.min(cards.length - 1, index));
      const card = cards[safeIdx];
      if (!card || !track) return 0;
      return card.offsetLeft - (track.clientWidth / 2) + (card.offsetWidth / 2);
    };

    // Helper: get the index of the card closest to center
    const getClosestCardIndex = () => {
      if (!track) return itemCount;
      const centerPos = track.scrollLeft + track.clientWidth / 2;
      let closestIndex = itemCount;
      let minDiff = Infinity;
      cards.forEach((card, idx) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const diff = Math.abs(cardCenter - centerPos);
        if (diff < minDiff) {
          minDiff = diff;
          closestIndex = idx;
        }
      });
      return closestIndex;
    };

    // 3D Coverflow Game Gallery Transform Calculation
    // Uses un-transformed layout geometry to eliminate feedback loops and reflows
    const update3DGallery = () => {
      if (!track) return;
      const trackCenter = track.scrollLeft + track.clientWidth / 2;
      const cardWidth = cards[0]?.offsetWidth || 260;

      cards.forEach((card) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const offset = cardCenter - trackCenter;
        const normalized = offset / (cardWidth * 0.72);

        // Clamped normalized factor
        const clamped = Math.max(-3, Math.min(3, normalized));
        const absNorm = Math.abs(clamped);

        // Left cards rotate positive (turn inward), right rotate negative (turn inward)
        const angle = clamped * -18;
        const scale = Math.max(0.86, 1.05 - Math.min(absNorm, 2) * 0.12);
        const zIndex = Math.round(50 - Math.min(absNorm, 4) * 10);
        const brightness = Math.max(0.78, 1 - Math.min(absNorm, 2) * 0.14);
        const opacity = Math.max(0.72, 1 - Math.min(absNorm, 2.5) * 0.12);
        const translateZ = Math.max(-20, 40 - absNorm * 30);

        card.style.transform = `perspective(1100px) rotateY(${angle.toFixed(1)}deg) scale(${scale.toFixed(3)}) translateZ(${translateZ.toFixed(1)}px)`;
        card.style.zIndex = `${zIndex}`;
        card.style.filter = `brightness(${brightness.toFixed(2)})`;
        card.style.opacity = `${opacity.toFixed(2)}`;
      });
      ticking = false;
    };

    const requestUpdate = () => {
      if (!ticking) {
        requestAnimationFrame(update3DGallery);
        ticking = true;
      }
    };

    track.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        if (!track) return;
        track.scrollLeft = getScrollForCard(targetIndex);
        requestUpdate();
      },
      { passive: true },
    );

    const stopAnimation = () => {
      if (animId !== null) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    };

    // Seamless coordinate wrapping across duplicate sets
    const wrapCoordinates = () => {
      if (!track || cards.length < 16) return;
      const loopWidth = getLoopWidth();
      if (loopWidth <= 0) return;

      let changed = false;
      while (targetIndex >= 16) {
        targetIndex -= itemCount;
        track.scrollLeft -= loopWidth;
        changed = true;
      }
      while (targetIndex < 8) {
        targetIndex += itemCount;
        track.scrollLeft += loopWidth;
        changed = true;
      }
      if (changed) {
        update3DGallery();
      }
    };

    // Silky frame-perfect RAF animation engine
    const animateToCard = (destIndex: number, duration = 380, onDone?: () => void) => {
      if (!track) return;
      stopAnimation();

      targetIndex = destIndex;
      const targetScroll = getScrollForCard(targetIndex);
      const startScroll = track.scrollLeft;
      const distance = targetScroll - startScroll;

      if (Math.abs(distance) < 0.5) {
        track.scrollLeft = targetScroll;
        wrapCoordinates();
        update3DGallery();
        onDone?.();
        return;
      }

      const startTime = performance.now();
      const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);

      const step = (now: number) => {
        if (!track) return;
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const factor = easeOutQuart(progress);

        track.scrollLeft = startScroll + distance * factor;
        update3DGallery();

        if (progress < 1) {
          animId = requestAnimationFrame(step);
        } else {
          track.scrollLeft = targetScroll;
          animId = null;
          wrapCoordinates();
          update3DGallery();
          onDone?.();
        }
      };

      animId = requestAnimationFrame(step);
    };

    // Initial center position at card 8 (Screen 1, middle loop)
    const initCenter = () => {
      if (!track || cards.length < 16) return;
      stopAnimation();
      targetIndex = itemCount;
      track.scrollLeft = getScrollForCard(itemCount);
      requestUpdate();
    };

    initCenter();
    window.addEventListener('load', initCenter);

    // Next (>) button - always advances forward seamlessly
    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (!track) return;
      wrapCoordinates();
      animateToCard(targetIndex + 1, 380);
    });

    // Prev (<) button - always advances backward seamlessly
    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (!track) return;
      wrapCoordinates();
      animateToCard(targetIndex - 1, 380);
    });

    // Keyboard navigation
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        wrapCoordinates();
        animateToCard(targetIndex + 1, 380);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        wrapCoordinates();
        animateToCard(targetIndex - 1, 380);
      }
    });

    // Grab-and-drag functionality (Mouse / Pointer)
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      stopAnimation();
      isDown = true;
      isDragging = false;
      dragDistance = 0;
      startX = e.pageX;
      scrollStart = track.scrollLeft;
      track.classList.add('is-dragging');
      document.body.classList.add('is-showcase-dragging');
      if (track.setPointerCapture) {
        track.setPointerCapture(e.pointerId);
      }
    });

    track.addEventListener('pointermove', (e) => {
      if (!isDown || !track) return;
      const delta = e.pageX - startX;
      dragDistance = Math.abs(delta);
      if (dragDistance > 4) {
        isDragging = true;
      }
      track.scrollLeft = scrollStart - delta;

      // Real-time seamless wrapping while dragging
      const loopWidth = getLoopWidth();
      if (loopWidth > 0) {
        const minBound = getScrollForCard(4);
        const maxBound = getScrollForCard(19);
        if (track.scrollLeft < minBound) {
          track.scrollLeft += loopWidth;
          scrollStart += loopWidth;
        } else if (track.scrollLeft > maxBound) {
          track.scrollLeft -= loopWidth;
          scrollStart -= loopWidth;
        }
      }

      update3DGallery();
    });

    const finishDrag = (e: PointerEvent) => {
      if (!isDown || !track) return;
      isDown = false;
      track.classList.remove('is-dragging');
      document.body.classList.remove('is-showcase-dragging');
      if (track.releasePointerCapture && track.hasPointerCapture(e.pointerId)) {
        track.releasePointerCapture(e.pointerId);
      }
      if (dragDistance > 4) {
        const closest = getClosestCardIndex();
        animateToCard(closest, 320);
      }
    };

    track.addEventListener('pointerup', finishDrag);
    track.addEventListener('pointercancel', finishDrag);

    // Clicking any card centers it smoothly
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        if (isDragging || !track) return;
        animateToCard(idx, 380);
      });
    });
  }
</script>
