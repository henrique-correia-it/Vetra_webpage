---
import type { SiteCopy } from '../../content/types';
import Icon from '../Icon.astro';

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
---

<section class="chapter comparison-chapter">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">{copy.comparison.eyebrow}</p>
      <h2>{copy.comparison.title}</h2>
      <p class="lede">{copy.comparison.text}</p>
    </div>
    <div class="comparison-grid">
      <!-- Others Card -->
      <div class="comparison-card comparison-card-others">
        <div class="comparison-header">
          <span class="comparison-pill others-pill">{copy.comparison.othersTitle}</span>
        </div>
        <ul class="comparison-list">
          {copy.comparison.others.map((item) => (
            <li>
              <span class="comparison-icon icon-negative">
                <Icon name="close" size={16} />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Vetra Card -->
      <div class="comparison-card comparison-card-vetra">
        <div class="comparison-header">
          <span class="comparison-pill vetra-pill">
            {copy.comparison.vetraTitle}
          </span>
        </div>
        <ul class="comparison-list">
          {copy.comparison.vetra.map((item) => (
            <li>
              <span class="comparison-icon icon-positive">
                <Icon name="check" size={16} />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Integrated Trust Pillars Strip -->
    <div class="trust-strip">
      {copy.trust.items.map((item, index) => (
        <div class="trust-strip-item">
          <div class="trust-strip-icon">
            <Icon name={['shield', 'cloud', 'backup'][index]} size={22} />
          </div>
          <div class="trust-strip-content">
            <h4>{item.title}</h4>
            <p>{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
