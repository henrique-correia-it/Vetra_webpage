---
import type { LocaleId } from '../content/types';
import { getCopy } from '../content/copy';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './sections/Hero.astro';
import Planning from './sections/Planning.astro';
import Showcase from './sections/Showcase.astro';
import Faq from './sections/Faq.astro';

interface Props {
  locale: LocaleId;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<Header locale={locale} copy={copy} />
<main id="main">
  <Hero locale={locale} copy={copy} />
  <Planning locale={locale} copy={copy} />
  <Showcase locale={locale} />
  <Faq locale={locale} copy={copy} />
</main>
<Footer locale={locale} copy={copy} />
