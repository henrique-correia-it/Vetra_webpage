---
import { Picture } from 'astro:assets';
import { siteImages, type SiteScene } from '../content/images';
import type { LocaleId } from '../content/types';
interface Props {
  locale: LocaleId;
  scene: SiteScene;
  alt: string;
  eager?: boolean;
}
const { locale, scene, alt, eager = false } = Astro.props;
const image = siteImages[locale][scene];
---

<Picture
  src={image.src}
  alt={alt}
  formats={['webp']}
  widths={[360, 600, 900]}
  sizes="(max-width: 640px) 75vw, (max-width: 1100px) 36vw, 380px"
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  class="app-artwork"
/>
